# AYCE configuration
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

AYCE_LOG_LEVEL=INFO
AYCE_DATA_DIR=data

# --- Media tooling (P4.5 renderer) ------------------------------------------
# Optional explicit executables; when unset, PATH lookup is used.
# Never hardcode machine paths in source.
#
# AYCE_FFMPEG_PATH=C:\path\to\ffmpeg.exe
# AYCE_FFPROBE_PATH=C:\path\to\ffprobe.exe

# --- Piper TTS narration (P7; OPT-IN — GPL-3.0, invoked as external CLI) ----
# When AYCE_PIPER_MODEL is unset (default), the deterministic file-backed
# narration provider is used and Piper is never invoked.
#
# AYCE_PIPER_PYTHON=C:\path\to\piper-env\Scripts\python.exe
# AYCE_PIPER_MODEL=C:\path\to\en_US-amy-medium.onnx
# AYCE_PIPER_CONFIG=C:\path\to\en_US-amy-medium.onnx.json
# AYCE_PIPER_LENGTH_SCALE=1.0
# AYCE_PIPER_LICENSE=voice-model-license-string (recorded in provenance)

# --- Stage 2 research worker (yt-dlp invoked as external CLI) ---------------
# Optional explicit yt-dlp executable; when unset, PATH lookup is used.
#
# AYCE_YTDLP_PATH=C:\path\to\yt-dlp.exe

# --- Stage 5: YouTube publishing (EXPLICIT `ayce publish` only) --------------
# Official YouTube Data API v3 via user/channel OAuth (NOT service accounts).
# One-time setup: `ayce publish-auth --auth-url` (operator consent in a
# browser) then `ayce publish-auth --auth-code <code>`. Secrets live ONLY
# here (git-ignored) — never in source, never in logs.
#
# AYCE_YT_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# AYCE_YT_CLIENT_SECRET=your-oauth-client-secret
# AYCE_YT_REFRESH_TOKEN=your-long-lived-refresh-token
# AYCE_YT_TOKEN_FILE=data/publishing/token.json     (access-token cache)
# AYCE_PUBLISH_LEDGER=data/publishing/ledger.sqlite3 (publish ledger)
#
# The first real publish acceptance MUST use privacy_status=private.

# --- Real visual assets: Pexels REST API (OPT-IN) -----------------------------
# Selected ONLY when AYCE_PEXELS_API_KEY is set; otherwise the deterministic
# fixture provider remains the default. The key is a SECRET and is never
# logged or committed. Orientation is provider configuration because the
# Scene Contract carries no orientation field.
#
# AYCE_PEXELS_API_KEY=your-pexels-api-key
# AYCE_PEXELS_ORIENTATION=landscape           # landscape|portrait|square
# AYCE_PEXELS_MIN_VIDEO_DURATION_S=4.0        # video scenes: minimum clip length
# AYCE_PEXELS_CACHE_DIR=data/assets_cache/pexels

# --- Real narration: Kokoro-82M (OPT-IN, local execution) ---------------------
# Selected ONLY when AYCE_KOKORO_VOICE is set (voice prefix = language:
# a/b = English, h = Hindi). Requires the optional runtime:
#   pip install -e ".[tts-kokoro]"
# Hindi additionally needs espeak-ng (the pip `espeakng-loader` runtime is
# included with misaki[en]); AYCE never installs system software itself.
#
# AYCE_KOKORO_VOICE=af_heart                # hf_alpha for Hindi
# AYCE_KOKORO_SPEED=1.0
# AYCE_KOKORO_REPO_ID=hexgrad/Kokoro-82M    # official weights repo only
# AYCE_KOKORO_LICENSE=Apache-2.0            # recorded in provenance when set
# AYCE_KOKORO_CACHE_DIR=data/narration_cache/kokoro

# --- Secrets ---------------------------------------------------------------
# Declare provider secrets here ONLY when a stage actually needs them.
# Access them via Config.require("<NAME>") — never hardcode them in source.
#
# AYCE_EXAMPLE_API_KEY=
