# AYCE configuration
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

AYCE_LOG_LEVEL=INFO
AYCE_DATA_DIR=data

# --- Media tooling (P4.5 renderer) ------------------------------------------
# Optional explicit executables; when unset, PATH lookup is used.
# Never hardcode machine paths in source.
#
# AYCE_FFMPEG_PATH=C:\path\to\ffmpeg.exe
# AYCE_FFPROBE_PATH=C:\path\to\ffprobe.exe


# --- Secrets ---------------------------------------------------------------
# Declare provider secrets here ONLY when a stage actually needs them.
# Access them via Config.require("<NAME>") — never hardcode them in source.
#
# AYCE_EXAMPLE_API_KEY=
