ytics API v2 (Targeted) &amp; Reporting API (Bulk Reach)</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:78pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Daily at 04:00 UTC (processes closed day T-3)</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:78pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">1 unit per Analytics query; 0 units for bulk downloads</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:78pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">DATA_STABLE_ENOUGH</span></p></td></tr><tr style="height:0pt"><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:78pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Tier 3: Mature Backfill</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:78pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Day 7, 14, and 30 Post-Publish</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:78pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Analytics API v2 &amp; Reporting API (Full Sync)</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:78pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Scheduled cron at Day 7, 14, and 30 post-publish</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:78pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Reconciles late views, bot sweeps, and partner revenue</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:78pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">DATA_FINALIZED</span></p></td></tr></tbody></table><h3 style="padding-top:12pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">Ingestion Mechanisms and Quota Arbiter</span></h3><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">The collection workflow reconciles metrics across four synchronized functional stages:</span></p><ol class="lst-kix_list_1-0 start" start="1" style="padding:0;margin:0"><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-weight:700">Scheduling and Batching</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: The Chronos scheduler manages video polling states in SQLite. Fast-feedback polling batches up to 50 active video IDs into a single videos.list request, keeping daily Data API consumption below 150 units even with multiple daily uploads.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-weight:700">Bulk Reach Synchronization</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: A daily cron job inspects Reporting API job outputs (channel_reach_basic_a1 and channel_reach_combined_a1). New CSV reports are downloaded from Google Cloud Storage signed URLs, decompressed locally, parsed for target video IDs, and ingested into staging tables. This bypasses Analytics API reach limitations without burning quota.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-weight:700">Targeted Query Ingestion</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: The Tier 2 worker uses analyt[span_8](start_span)[span_8](end_span)ix to query the Analytics API for engagedViews, watch time, traffic sources, and retention curves. Requests set startDate and endDate to match fully processed historical days, preventing truncation errors.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-weight:700">Idempotency and Conflict Resolution</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: Metric records use composite primary keys: (video_id, ap[span_44](start_span)[span_44](end_span)[span_48](start_span)[span_48](end_span)i_source, reporting_period_start, reporting_period_end, metric_name, dimension_name, dimension_value). Ingestion uses SQLite INSE[span_45](start_span)[span_45](end_span)[span_49](start_span)[span_49](end_span)RT OR REPLACE semantics, guaranteeing that retries or overlapping backfills update historical estimates without creating duplicate rows.</span></li></ol><h2 style="padding-top:11.2pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:18pt;padding-bottom:11.2pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:18pt;font-family:&quot;Arial&quot;;font-style:normal">5. Canonical Data Model</span></h2><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">The canonical schema enforces an architectural separation between observed platform data, derived mathematical normalizations, statistical model inferences, and accepted production policies. The entire data store is implemented directly in SQLite utilizing Write-Ahead Logging (PRAGMA journal_mode = WAL;) to support concurrent asynchronous readers and ingestion writers.</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:11.2pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">-- Production Lineage DAG: Tracks Genesis to Publication<br>CREATE TABLE IF NOT EXISTS production_lineage (<br> [span_10](start_span)[span_10](end_span) &nbsp; lineage_id TEXT PRIMARY KEY,<br> &nbsp; &nbsp;idea_id TEXT NOT NULL,<br> &nbsp; &nbsp;research_run_id TEXT NOT NULL,<br> &nbsp; &nbsp;angle_slug TEXT NOT NULL,<br> &nbsp; &nbsp;script_id TEXT NOT NULL,<br> &nbsp; &nbsp;scene_plan_id TEXT NOT NULL,<br> &nbsp; &nbsp;render_id TEXT NOT NULL,<br> &nbsp; &nbsp;qa_manifest_id TEXT NOT NULL,<br> &nbsp; &nbsp;publish_package_id TEXT NOT NULL[span_79](start_span)[span_79](end_span)[span_99](start_span)[span_99](end_span),<br> &nbsp; &nbsp;created_at DATETIME DEFAULT CURRENT_TIMESTAMP<br>);<br><br>-- Published Video Entity<br>CREATE TABLE IF NOT EXISTS published_videos (<br> &nbsp; &nbsp;video_id TEXT PRIMARY KEY, &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; -- YouTube 11-character ID<br> &nbsp; &nbsp;lineage_id TEXT NOT NULL REFERENCES production_lineage(lineage_id),<br> &nbsp; &nbsp;channel_id TEXT NOT NULL,<br> &nbsp; &nbsp;published_at DATETIME NOT NULL,<br> &nbsp; &nbsp;duration_seconds REAL NOT NULL,<br> &nbsp; &nbsp;format_type TEXT CHECK(format_type IN ('LONG_FORM', 'SHORTS', 'LIVE_VOD')),<br> &nbsp; &nbsp;current_status TEXT NOT NULL, &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; -- 'PUBLIC', 'UNLISTED', 'REMOVED'<br> &nbsp; &nbsp;freshness_state TEXT NOT NULL CHECK(freshness_state IN (<br> &nbsp; &nbsp; &nbsp; &nbsp;'DATA_PENDING', 'DATA_PARTIAL', 'DATA_STABLE_ENOUGH', 'DATA_FINALIZED'<br> &nbsp; &nbsp;)),<br> &nbsp; &nbsp;updated_at DATETIME DEFAULT CURRENT_TIMESTAMP<br>);<br><br>-- Immutable Raw Metric Observations (Provenance Ledger)<br>CREATE TABLE IF NOT EXISTS raw_metric_observations (<br> &nbsp; &nbsp;observation_id INTEGER PRIMARY KEY AUTOINCREMENT,<br> &nbsp; &nbsp;video_id TEXT NOT NULL REFERENCES published_videos(video_id),<br> &nbsp; &nbsp;api_source TEXT NOT NULL CHECK(api_source IN ('DATA_API_V3', 'ANALYTICS_API_V2', 'REPORTING_API_V1')),<br> &nbsp; &nbsp;reporting_period_start DATE NOT NULL,<br> &nbsp; &nbsp;reporting_period_end DATE NOT NULL,<br> &nbsp; &nbsp;metric_name TEXT NOT NULL,<br> &nbsp; &nbsp;dimension_name TEXT NOT NULL DEFAULT 'TOTAL',<br> &nbsp; &nbsp;dimension_value TEXT NOT NULL DEFAULT 'TOTAL',<br> &nbsp; &nbsp;metric_value REAL NOT NULL,<br> &nbsp; &nbsp;api_version TEXT NOT NULL,<br> &nbsp; &nbsp;query_parameters_hash TEXT NOT NULL,<br> &nbsp; &nbsp;retrieved_at DATETIME NOT NULL,<br> &nbsp; &nbsp;UNIQUE(video_id, api_source, reporting_period_start, reporting_period_end, metric_name, dimension_name, dimension_value)<br>);<br><br>-- Audience Retention High-Density Curve<br>CREATE TABLE IF NOT EXISTS retention_observations (<br> &nbsp; &nbsp;video_id TEXT NOT NULL REFERENCES published_videos(video_id),<br> &nbsp; &nbsp;elapsed_time_ratio REAL NOT NULL CHECK(elapsed_time_ratio &gt;= 0.0 AND elapsed_time_ratio &lt;= 1.0),<br> &nbsp; &nbsp;audience_watch_ratio REAL NOT NULL,<br> &nbsp; &nbsp;relative_retention_performance REAL,<br> &nbsp; &nbsp;started_watching INTEGER,<br> &nbsp; &nbsp;stopped_watching INTEGER,<br> &nbsp; &nbsp;total_segment_impressions INTEGER,<br> &nbsp; &nbsp;retrieved_at DATETIME NOT NULL,<br> &nbsp; &nbsp;PRIMARY KEY(video_id, elapsed_time_ratio)<br>);<br><br>-- Extracted Creative Features<br>CREATE TABLE IF NOT EXISTS creative_features (<br> &nbsp; &nbsp;video_id TEXT PRIMARY KEY REFERENCES published_videos(video_id),<br> &nbsp; &nbsp;hook_duration_seconds REAL NOT NULL,<br> &nbsp; &nbsp;hook_type TEXT NOT NULL, &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;-- 'CURIOSITY_GAP', 'PROVOCATIVE_CLAIM', 'DIRECT_QUESTION', 'IN_MEDIA_RES'<br> &nbsp; &nbsp;script_word_count INTEGER NOT NULL,<br> &nbsp; &nbsp;narration_wpm REAL NOT NULL,<br> &nbsp; &nbsp;scene_frequency_per_min REAL NOT NULL,<br> &nbsp; &nbsp;avg_shot_duration_seconds REAL NOT NULL,<br> &nbsp; &nbsp;visual_change_frequency_hz REAL NOT NULL,<br> &nbsp; &nbsp;b_roll_ratio REAL NOT NULL,<br> &nbsp; &nbsp;cta_timestamp_seconds REAL,<br> &nbsp; &nbsp;title_word_count INTEGER NOT NULL,<br> &nbsp; &nbsp;title_sentiment_score REAL NOT NULL,<br> &nbsp; &nbsp;thumbnail_face_present BOOLEAN NOT NULL,<br> &nbsp; &nbsp;thumbnail_text_overlay BOOLEAN NOT NULL,<br> &nbsp; &nbsp;thumbnail_dominant_hue REAL,<br> &nbsp; &nbsp;extracted_at DATETIME DEFAULT CURRENT_TIMESTAMP<br>);<br><br>-- Normalized Performance Snapshots<br>CREATE TABLE IF NOT EXISTS performance_snapshots (<br> &nbsp; &nbsp;snapshot_id INTEGER PRIMARY KEY AUTOINCREMENT,<br> &nbsp; &nbsp;video_id TEXT NOT NULL REFERENCES published_videos(video_id),<br> &nbsp; &nbsp;snapshot_window TEXT NOT NULL CHECK(snapshot_window IN ('T24H', 'T48H', 'T7D', 'T14D', 'T30D')),<br> &nbsp; &nbsp;raw_views INTEGER NOT NULL,<br> &nbsp; &nbsp;engaged_views INTEGER,<br> &nbsp; &nbsp;watch_time_minutes REAL NOT NULL,<br> &nbsp; &nbsp;impressions INTEGER,<br> &nbsp; &nbsp;ctr REAL,<br> &nbsp; &nbsp;average_view_percentage REAL NOT NULL,<br> &nbsp; &nbsp;views_velocity_zscore REAL NOT NULL,<br> &nbsp; &nbsp;watch_time_zscore REAL NOT NULL,<br> &nbsp; &nbsp;channel_percentile_rank REAL NOT NULL,<br> &nbsp; &nbsp;computed_at DATETIME DEFAULT CURRENT_TIMESTAMP,<br> &nbsp; &nbsp;UNIQUE(video_id, snapshot_window)<br>);<br><br>-- Learning Candidates &amp; Epistemic Knowledge Store<br>CREATE TABLE IF NOT EXISTS learning_candidates (<br> &nbsp; &nbsp;candidate_id TEXT PRIMARY KEY,<br> &nbsp; &nbsp;feature_key TEXT NOT NULL,<br> &nbsp; &nbsp;observed_correlation REAL NOT NULL,<br> &nbsp; &nbsp;sample_size INTEGER NOT NULL,<br> &nbsp; &nbsp;supporting_video_ids TEXT NOT NULL, &nbsp; &nbsp; -- JSON Array<br> &nbsp; &nbsp;counterexample_video_ids TEXT NOT NULL, -- JSON Array<br> &nbsp; &nbsp;confidence_interval_low REAL NOT NULL,<br> &nbsp; &nbsp;confidence_interval_high REAL NOT NULL,<br> &nbsp; &nbsp;proposed_heuristic TEXT NOT NULL,<br> &nbsp; &nbsp;validation_status TEXT NOT NULL CHECK(validation_status IN (<br> &nbsp; &nbsp; &nbsp; &nbsp;'PENDING', 'VALIDATED', 'REJECTED', 'SUPERSEDED'<br> &nbsp; &nbsp;)),<br> &nbsp; &nbsp;rejection_reason TEXT,<br> &nbsp; &nbsp;created_at DATETIME DEFAULT CURRENT_TIMESTAMP,<br> &nbsp; &nbsp;validated_at DATETIME<br>);<br></span></p><h2 style="padding-top:0pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:18pt;padding-bottom:11.2pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:18pt;font-family:&quot;Aria