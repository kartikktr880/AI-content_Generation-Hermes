quot;;font-style:normal">Group Sequential Multi-Arm Design</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:117pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Worker Allocation &amp; Research Depth</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:117pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Alpha spending functions tracking interim batch results</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:117pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Internal asset generation runs and compute pipelines</span></p></td></tr><tr style="height:0pt"><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:117pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Observational Regression Discontinuity</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:117pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Release Scheduling &amp; Niche Shifts</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:117pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Counterfactual synthetic controls built from reference channel cohorts</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:117pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Strategic pivot evaluation and audience cohort tracking</span></p></td></tr></tbody></table><h2 style="padding-top:11.2pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:18pt;padding-bottom:11.2pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:18pt;font-family:&quot;Arial&quot;;font-style:normal">4. Experiment Registry</span></h2><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">The ExperimentRegistry is the centralized state engine that manages active and historical experimentation. It enforces pre-registered stopping rules, tracks sample accumulation, and ensures that experiments are not altered or aborted prematurely without statistical justification.</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">The registry is formalized in SQLite with explicit operational constraints:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">CREATE TABLE experiment_registry (<br> &nbsp; &nbsp;experiment_id TEXT PRIMARY KEY,<br> &nbsp; &nbsp;hypothesis_id TEXT NOT NULL,<br> &nbsp; &nbsp;candidate_id TEXT NOT NULL,<br> &nbsp; &nbsp;study_design TEXT CHECK(study_design IN (<br> &nbsp; &nbsp; &nbsp; &nbsp;'CONCURRENT_SPLIT_NATIVE', 'MATCHED_PAIR_TOPIC', <br> &nbsp; &nbsp; &nbsp; &nbsp;'INTERRUPTED_TIME_SERIES', 'GROUP_SEQUENTIAL_BATCH'<br> &nbsp; &nbsp;)) NOT NULL,<br> &nbsp; &nbsp;treatment_parameters_json TEXT NOT NULL,<br> &nbsp; &nbsp;control_parameters_json TEXT NOT NULL,<br> &nbsp; &nbsp;target_scope_json TEXT NOT NULL,<br> &nbsp; &nbsp;randomization_unit TEXT NOT NULL,<br> &nbsp; &nbsp;primary_metric TEXT NOT NULL,<br> &nbsp; &nbsp;secondary_guardrails_json TEXT NOT NULL,<br> &nbsp; &nbsp;minimum_detectable_effect REAL NOT NULL,<br> &nbsp; &nbsp;target_sample_size INTEGER NOT NULL,<br> &nbsp; &nbsp;current_sample_size INTEGER DEFAULT 0,<br> &nbsp; &nbsp;alpha_budget REAL DEFAULT 0.05,<br> &nbsp; &nbsp;cumulative_alpha_spent REAL DEFAULT 0.0,<br> &nbsp; &nbsp;current_test_statistic REAL DEFAULT 0.0,<br> &nbsp; &nbsp;p_value_or_e_value REAL,<br> &nbsp; &nbsp;start_time DATETIME DEFAULT CURRENT_TIMESTAMP,<br> &nbsp; &nbsp;interim_check_interval_hours INTEGER DEFAULT 24,<br> &nbsp; &nbsp;last_interim_check DATETIME,<br> &nbsp; &nbsp;status TEXT CHECK(status IN (<br> &nbsp; &nbsp; &nbsp; &nbsp;'QUEUED', 'ACTIVE_RUNNING', 'PAUSED_INTERIM', <br> &nbsp; &nbsp; &nbsp; &nbsp;'CONCLUDED_WINNER', 'CONCLUDED_INCONCLUSIVE', <br> &nbsp; &nbsp; &nbsp; &nbsp;'ABORTED_REGRESSION', 'ABORTED_FUTILITY'<br> &nbsp; &nbsp;)) DEFAULT 'QUEUED',<br> &nbsp; &nbsp;terminal_summary_json TEXT,<br> &nbsp; &nbsp;resulting_decision_id TEXT<br>);<br></span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:11.2pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Under this schema, fields governing sample size, MDE, alpha spending, and secondary guardrails are strictly mandatory. When an experiment is initialized, the system locks its statistical parameters; the compiler cannot retroactively alter the primary metric or change the MDE to manufacture significance during analysis.</span></p><h2 style="padding-top:0pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:18pt;padding-bottom:11.2pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:18pt;font-family:&quot;Arial&quot;;font-style:normal">5. Decision Candidate Model</span></h2><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">A validated learning finding from outlier analysis cannot be directly pushed into production. It must first be compiled into a standardized, machine-readable DecisionCandidate that captures the complete operational trade-off, costs, risks, and verification requirements.</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">{<br> &nbsp;"candidate_id": "cand_creative_pacing_2026_04",<br> &nbsp;"hypothesis_id": "hyp_dropoff_wpm_019",<br> &nbsp;"decision_action": "ADAPT_PARAMETER",<br> &nbsp;"target_parameter_path": "parameters.script.pacing_target_wpm",<br> &nbsp;"proposed_value": 165,<br> &nbsp;"incumbent_value": 185,<br> &nbsp;"rationale": "Empirical outlier analysis indicates videos with first-30-second pacing &gt; 180 WPM incur an 8.2% steeper drop-off than videos paced at 160-170 WPM.",<br> &nbsp;"evidence_ids": [<br> &nbsp; &nbsp;"evi_outlier_4k_088",<br> &nbsp; &nbsp;"evi_outlier_4k_092"<br> &nbsp;],<br> &nbsp;"counterexamples": [<br> &nbsp; &nbsp;{<br> &nbsp; &nbsp; &nbsp;"video_id": "yt_vid_4412",<br> &nbsp; &nbsp; &nbsp;"observed_context": "Pacing at 188 WPM succeeded due to extreme visual scene density (0.8s cuts)."<br> &nbsp; &nbsp;}<br> &nbsp;],<br> &nbsp;"scope": {<br> &nbsp; &nbsp;"channel_id": "UC_autonomous_science",<br> &nbsp; &nbsp;"content_pillar": "deep_dive_explainer",<br> &nbsp; &nbsp;"video_format": "standard_longform"<br> &nbsp;},<br> &nbsp;"confidence_score": 0.86,<br> &nbsp;"expected_effect": {<br> &nbsp; &nbsp;"primary_metric": "retention_30s",<br> &nbsp; &nbsp;"expected_delta_relative": 0.055,<br> &nbsp; &nbsp;"confidence_interval_95": [0.018, 0.092]<br> &nbsp;},<br> &nbsp;"cost_impact": {<br> &nbsp; &nbsp;"gpu_seconds_delta": 0,<br> &nbsp; &nbsp;"api_cost_usd_delta": 0.0,<br> &nbsp; &nbsp;"production_time_delta_sec": 0<br> &nbsp;},<br> &nbsp;"risk_profile": {<br> &nbsp; &nbsp;"reversibility_tier": "TIER_1_REVERSIBLE",<br> &nbsp; &nbsp;"audience_fatigue_probability": "LOW",<br> &nbsp; &nbsp;"compliance_risk": "ZERO"<br> &nbsp;},<br> &nbsp;"experiment_required": true,<br> &nbsp;"recommended_design": "MATCHED_PAIR_TOPIC",<br> &nbsp;"approval_mode": "AUTO_WITH_BOUNDS",<br> &nbsp;"status": "PROPOSED",<br> &nbsp;"created_at": "2026-03-30T09:00:00Z"<br>}<br></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">The fields included in this schema represent the exact necessary boundary for decision intelligence:</span></p><ul class="lst-kix_list_3-0 start" style="padding:0;margin:0"><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">candidate_id and hypothesis_id: Provide unambiguous traceability back to the formal research hypothesis.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">decision_action and target_parameter_path: Isolate the precise operational lever in the policy document to prevent broad, unconstrained mutations.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">proposed_value and incumbent_value: Explicitly define the operational delta.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">rationale, evidence_ids, and counterexamples: Prevent positive confirmation bias by requiring the extraction of contradictory data points before approval.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">scope: Limits the blast radius to specified channels, content pillars, or formats.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">cost_impact and risk_profile: Feed the lexicographic optimization model and risk budget verifier.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">experiment_required and approval_mode: Determine the mandatory governance pipeline.</span></li></ul><h2 style="padding-top:11.2pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:18pt;padding-bottom:11.2pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:18pt;font-family:&quot;Arial&quot;;font-style:normal">6. Statistical Decision Architecture</span></h2><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Autonomous decision intelligence in YouTube production requires accounting for platform-native features, control group validity, confounding randomization units, and variance-adjusted statistical power.</span></p><h3 style="padding-top:0pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">YouTube-Native Experimentation Mechanics</span></h3><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Google provides a native split-testing feature in YouTube Studio designated as "A/B test titles &amp; thumbnails" (formerly "Test &amp; Compare"). Integrating autonomous systems requires understanding its precise operational reality:</span></p><ul class="lst-kix_list_4-0 start" style="padding:0;margin:0"><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-style:italic">Verified Fact</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: As of 2026, YouTube does not expose the title and thumbnail A/B testing mechanism in the public YouTube Data API v3. Google Issue Tracker feature request #536234341 remains open. Public API endpoints (thumbnails.set and videos.update) set only a single static asset and cannot initialize native split tests.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-style:italic">Studio Operational Boundaries</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: Testing is available strictly via desktop browsers in YouTube Studio. Channels must have YouTube "Advanced Features" enabled and maintain full Community Guidelines compliance.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-style:italic">Format Restrictions</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: A/B testing is explicitly unsupported on Shorts, scheduled live streams, active Premieres (only eligible once converted to standard on-demand videos), private videos, and age-restricted (18+) content. If age-restricted material is uploaded without explicit flags, channel testing privileges are revoked.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-style:italic">Technical Constraints</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: Up to 3 titles, 3 thumbnails, or 3 paired combinations can be tested simultaneously. If any uploaded thumbnail is below 1280x720 (720p), YouTube downscales all test variants in that experiment to 854x480 (480p), degrading display quality.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-style:italic">Optimization Target</span><span>: YouTube tests optimize for </span><span style="font-weight:700">Watch Time Share</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">, not raw Click-Through Rate. If Variant A yields a 9% CTR but severe drop-off at 20 seconds, while Variant B yields a 7% CTR with high retention, Variant B captures more watch time share and wins.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-style:italic">The Interruption Rule</span><span>: </span><span style="font-style:italic">Verified Fact</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">. Updating a video's title or thumbnail via external API or human action while a native A/B test is active immediately cancels the experiment, permanently erasing cumulative statistical data.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-style:italic">Automation Realities</span><span>: Third-party tools (such as ThumbnailTest or Feedzy) execute </span><span style="font-style:italic">sequential time-based swapping</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;using repeated thumbnails.set (50 quota units) and videos.update (50 quota units) calls, cycling variants every 24 hours. This workaround introduces temporal confounding from day-of-week viewer variation and rapidly depletes the default 10,000-unit daily API quota. True native split testing requires isolated headless browser automation (Playwright) operating within YouTube Studio under human oversight.</span></li></ul><h3 style="padding-top:12pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">Control Group Construction</span></h3><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">The system constructs defensible controls across three distinct experimental situations:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">[Packaging Optimizat[span_37](start_span)[span_37](end_span)[span_39](start_span)[span_39](end_span)[span_41](start_span)[span_41](end_span)ion] &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;â”€â”€â–º Concurrent Platform Split (YouTube Studio Server-Side)<br>[Creative / Production Levers] &nbsp; &nbsp;â”€â”€â–º Matched-Pair Topic Controls (Adjacent Balanced Releases)<br>[Macro Pipeline / Model Updates] &nbsp;â”€â”€â–º Synthetic Counterfactuals (Bayesian Structural Time Series)<br></span></p><ol class="lst-kix_list_5-0 start" start="1" style="padding:0;margin:0"><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-weight:700">Simultaneous Platform Split</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: Applied exclusively to packaging via YouTube's server-side system, routing live incoming viewer traffic concurrently across variants to neutralize seasonal, temporal, and trending biases.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-weight:700">Matched-Pair Topic Controls</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: For creative levers (such as hook structure or scene pacing), the compiler groups two adjacent production releases within the same topic cluster. Video A receives Champion parameters; Video B receives Challenger parameters. Covariates (target duration \pm 10\%, keyword search intent, publishing hour) are balanced prior to production, and performance is evaluated using differences-in-differences against historical cluster baselines.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-weight:700">Synthetic Counterfactuals</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: For macro pipeline changes (e.g., deploying a new generative video model), individual video controls are unviable. The system builds a synthetic counterfactual using Bayesian Structural Time Series (bsts-causalimpact), modeling channel trajectory against external reference series (category search trends, competitor view trajectories) to isolate true causal lift.</span></li></ol><h3 style="padding-top:12pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">Randomization Units and Platform Mechanics</span></h3><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Randomizing individual frames or scenes within an uploaded video is impossible on YouTube. Randomizing video releases across consecutive days introduces severe algorithmic carryover effects: an exceptionally viral video elevates channel recommendation authority, artificially inflating impressions for subsequent uploads regardless of quality.</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span>Randomization is therefore structured at the level of </span><span style="font-style:italic">production topic pairs</span><span>&nbsp;or </span><span style="font-style:italic">alternating multi-week production blocks</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">. The engine explicitly isolates and normalizes four primary platform confounders:</span></p><ul class="lst-kix_list_6-0 start" style="padding:0;margin:0"><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-style:italic">Traffic Source Composition</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: Metrics must be evaluated separately across "Browse Features," "Suggested Videos," and "YouTube Search," as each possesses fundamentally different baseline CTR and retention profiles.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-style:italic">Viewer Familiarity</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: Returning subscribers retain at substantially higher rates than casual new viewers; all continuous metrics are stratified by subscription status.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-style:italic">Temporal Periodicity</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: Day-of-week browsing densities skew retention; matched controls must share identical publishing calendar slots.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-style:italic">Algorithmic S-Curves</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: Impression distributions follow non-linear logistic velocity curves; analytical evaluation windows remain closed during the initial 48-hour acceleration phase.</span></li></ul><h3 style="padding-top:12pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">Sample Size and Statistical Power Calculations</span></h3><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Arbitrary sample sizes (N=5, N=10, N=30) are prohibited. In content production, sample sizes must be calculated from baseline metric variance.</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">For binary packaging outcomes (clicks per impression), the sample size per arm n is calculated via two-tailed proportion testing:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">n = \frac{2 \left( Z_{\alpha/2} + Z_{\beta} \right)^2 \cdot p (1 - p)}{\Delta^2}</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Where Z_{\alpha/2} = 1.96 for \alpha = 0.05, Z_{\beta} = 0.84 for 80\% power, p is baseline conversion, and \Delta is the Minimum Detectable Effect (MDE).</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">For continuous creative metrics (e.g., 30-second retention percentage), the sample size across matched pairs is computed as:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">N_{\text{pairs}} = \frac{2 \left( Z_{\alpha/2} + Z_{\beta} \right)^2 \sigma^2}{\left( \mu_{\text{challenger}} - \mu_{\text{champion}} \right)^2}</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Because video-level sample counts are physically constrained by production throughput, detecting small effects (\text{MDE} &lt; 3\%) would require an impractical number of uploads (N &gt; 80). The system resolves this via two methodological mechanisms:</span></p><ul class="lst-kix_list_7-0 start" style="padding:0;margin:0"><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-weight:700">CUPED (Controlled-experiment Using Pre-Experiment Data)</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: Regresses post-treatment metrics against pre-exposure viewer retention and topic interest baselines. This reduces metric variance \sigma^2 by a factor of (1 - \rho^2) (where \rho is the correlation between pre- and post-treatment metrics), decreasing required video sample sizes by 30\% to 50\%.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="font-weight:700">Bayesian Region of Practical Equivalence (ROPE)</span><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">: The compiler evaluates the posterior distribution over the effect size. If 95\% of the posterior probability mass falls outside the ROPE ([-1\%, +1\%] relative change), the decision compiler acts without waiting for prohibitive frequentist sample sizes.</span></li></ul><h2 style="padding-top:11.2pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:18pt;padding-bottom:11.2pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:18pt;font-family:&quot;Arial&quot;;font-style:normal">7. Sequential and Adaptive Experimentation</span></h2><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Continuous daily monitoring ("peeking") at cumulative A/B testing data inflates Type I false positive rates: running standard two-sample t-tests daily across a 30-day trial inflates the nominal false positive rate from 4.2\% to 30.2\% under a true null effect.</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">To enable safe interim evaluation and early stopping, the Decision Compiler executes the Mixture Sequential Probability Ratio Test (mSPRT) and group sequential designs with Lan-DeMets alpha spending functions.</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">Interim Evaluation Pipeline:<br>[Measurement Window (t)] â”€â”€â–º [Compute mSPRT Statistic / E-Value]<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;â”‚<br> &nbsp; &nbsp; &nbsp; â”Œâ”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”¼â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”<br> &nbsp; &nbsp; &nbsp; â–¼ &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;â–¼ &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;â–¼<br>[E-Value &gt;= 1/alpha] &nbsp; &nbsp; &nbsp; &nbsp;[Futility Boundary Crossed] &nbsp; &nbsp;[Continuation Region]<br> &nbsp;STOP FOR EFFECT &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; STOP FOR FUTILITY &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;CONTINUE<br> &nbsp;Promote Candidate &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Archive Hypothesis &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Collect Next Batch<br></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Under mSPRT, the likelihood ratio \tilde{\Lambda}_n is integrated over a mixture distribution H with variance parameter \tau^2:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">\tilde{\Lambda}_n = \sqrt{\frac{V_n}{V_n + n \tau^2}} \exp \left( \frac{n^2 \tau^2 \bar{X}_n^2}{2 \sigma^2 (V_n + n \tau^2)} \right)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Where V_n = n \sigma^2. The compiler applies Villeâ€™s inequality, guaranteeing that under the null hypothesis, the probability that \tilde{\Lambda}_n \ge 1/\alpha at any point in the sequence is bounded strictly by \alpha. This allows the Decision Compiler to evaluate data at 48-hour intervals and trigger early stopping without inflating error rates.</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Interim evaluations result in one of four compiler actions:</span></p><ul class="lst-kix_list_8-0 start" style="padding:0;margin:0"><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">STOP FOR EFFECT: The candidate crosses the upper boundary (\tilde{\Lambda}_n \ge 1/\alpha). Testing stops immediately, and the candidate is queued for promotion.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">STOP FOR FUTILITY: The conditional probability of achieving the required MDE before exhausting the sample budget drops below 10\%. The experiment terminates immediately, preserving production resources.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">ESCALATE: A secondary guardrail metric (e.g., dislike ratio or render failure rate) breaches the negative non-inferiority margin, aborting the run immediately.</span></li><li style="padding:0;color:#000000;font-size:11pt;line-height:1.0;margin-right:0;margin-left:30pt;font-family:&quot;Arial&quot;;margin-top:0;margin-bottom:0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">CONTINUE: The test statistic resides within the continuation region; production continues under the experimental policy.</span></li></ul><h2 style="padding-top:11.2pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:18pt;padding-bottom:11.2pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:18pt;font-family:&quot;Arial&quot;;font-style:normal">8. Bandits vs. A/B Testing vs. Observational Analysis</span></h2><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Multi-armed bandits (MAB) and reinforcement learning algorithms are frequently proposed for autonomous optimization but encounter severe operational failure modes when applied to YouTube video publishing:</span></p><table style="border-spacing:0;border-collapse:collapse;margin-right:auto"><thead><tr style="height:0pt"><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:117pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Evaluation Dimension</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:117pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Classical / Sequential A/B Testing</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:117pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Multi-Armed Bandits (LinUCB / LinTS)</span></p></td><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:117pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Matched Observational Causal Analysis</span></p></td></tr></thead><tbody></tbody><tbody><tr style="height:0pt"><td colspan="1" rowspan="1" style="border-right-style:solid;border-bottom-color:#000000;border-top-width:1pt;border-right-width:1pt;border-left-color:#000000;vertical-align:top;border-right-color:#000000;border-left-width:1pt;border-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:117pt;border-top-color:#000000;border-bottom-style:solid"><p style="padding:0;margin:0;color:#000000;font-size:11pt;font